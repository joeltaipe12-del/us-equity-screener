    <worksheet name='BT - KPI SHARPE'>
      <table>
        <view>
          <datasources>
            <datasource caption='portfolio_cumulative' name='federated.19hedy7075c5hx1fdi2yr0uhd92e' />
          </datasources>
          <datasource-dependencies datasource='federated.19hedy7075c5hx1fdi2yr0uhd92e'>
            <column caption='Portfolio CAGR ' datatype='real' default-format='p0.0%' name='[Calculation_0047807258267650]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='POWER(EXP(SUM(LN(1 + [portfolio_returns]))), 12.0 / COUNT([portfolio_returns])) - 1' />
            </column>
            <column caption='SPY CAGR ' datatype='real' default-format='p0.0%' name='[Calculation_0047807258505219]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='POWER(EXP(SUM(LN(1 + [spy_return]))), 12.0 / COUNT([spy_return])) - 1' />
            </column>
            <column caption='Portfolio Vol ' datatype='real' default-format='p0.0%' name='[Calculation_0047807260004356]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='STDEV([portfolio_returns]) * SQRT(12)' />
            </column>
            <column caption='SPY VOL ' datatype='real' default-format='p0.0%' name='[Calculation_0047807260667909]' role='measure' type='quantitative'>
