      <column caption='Portfolio Total Returns' datatype='real' datatype-customized='true' default-format='p0%' name='[Calculation_0047807253872640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(SUM(LN(1 + [portfolio_returns]))) - 1' />
      </column>
      <column caption='SPY Total Return ' datatype='real' default-format='p0%' name='[Calculation_0047807254171649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='EXP(SUM(LN(1 + [spy_return]))) - 1' />
      </column>
      <column caption='Portfolio CAGR ' datatype='real' default-format='p0.0%' name='[Calculation_0047807258267650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='POWER(EXP(SUM(LN(1 + [portfolio_returns]))), 12.0 / COUNT([portfolio_returns])) - 1' />
      </column>
      <column caption='SPY CAGR ' datatype='real' default-format='p0.0%' name='[Calculation_0047807258505219]' role='measure' type='quantitative'>
